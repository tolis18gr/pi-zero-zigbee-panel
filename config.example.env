# Αντέγραψε το αρχείο ως panel.env και άλλαξε τις τιμές.
# Το panel.env ΔΕΝ ανεβαίνει στο GitHub (κωδικοί κ.λπ.).

# --- MQTT του Home Assistant (Mosquitto add-on)
PANEL_MQTT_HOST=192.168.1.10
PANEL_MQTT_PORT=1883
PANEL_MQTT_USER=
PANEL_MQTT_PASS=
PANEL_BASE_TOPIC=zigbee2mqtt
PANEL_DEMO=0

# --- Οθόνη (3.2" Waveshare, ILI9341 μέσω fbtft)
PANEL_OUTPUT=fb
PANEL_FB=/dev/fb1
PANEL_WIDTH=320
PANEL_HEIGHT=240

# --- Αφή: γράφεται αυτόματα με ./calibrate.sh

# --- Coordinator μέσω ser2net (γράφεται αυτόματα από ./coordinator.sh)
PANEL_SER2NET_PORT=6638
PANEL_COORDINATOR_DEV=
# auto | local | remote (remote = ο coordinator είναι σε άλλο μηχάνημα)
PANEL_COORDINATOR_MODE=auto

# --- Κουμπιά K1-K3 (./buttons.sh)
PANEL_KEYS_REVERSED=0
PANEL_LONG_PRESS=0.7
